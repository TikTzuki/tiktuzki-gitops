# Template for /etc/cluster-backup/s3.env  —  install as root, mode 0600.
#
#   sudo install -d -m700 /etc/cluster-backup
#   sudo install -m600 -T infra/backup/systemd/s3.env.example /etc/cluster-backup/s3.env
#   sudo nano /etc/cluster-backup/s3.env      # fill in the real values
#
# NEVER commit the filled-in version. It holds a live AWS secret key.
#
# systemd EnvironmentFile parses KEY=VALUE literally: no shell, no quotes stripped beyond
# a single surrounding pair, no $VAR expansion. Do not add `export`.

# ── where ────────────────────────────────────────────────────────────────────────────
S3_BUCKET=tiktuzki-cluster-backup
S3_PREFIX=node1
AWS_REGION=ap-southeast-1

# ── how it is encrypted ──────────────────────────────────────────────────────────────
# The age PUBLIC key. The matching identity file must never exist on this host — that is
# the whole point: node1 can encrypt and upload, and cannot read back what it sent.
# Generate on your laptop with:  age-keygen -o backup-identity.txt
AGE_RECIPIENT=age1REPLACE_ME

# ── credentials ──────────────────────────────────────────────────────────────────────
# IAM user restricted to s3:PutObject (+ AbortMultipartUpload) on this prefix. See the
# crate README for the policy. Nothing else on this host should be able to read this file.
AWS_ACCESS_KEY_ID=AKIAREPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME

# ── cadence and classes (optional; these are the defaults) ───────────────────────────
# Deep Archive bills a 180-day minimum per object, so the large half goes up weekly.
#UPLOAD_BULK_DOW=7
#CRITICAL_CLASS=STANDARD_IA
#BULK_CLASS=DEEP_ARCHIVE
